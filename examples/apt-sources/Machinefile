FROM ubuntu:26.04
RUN apt update
RUN apt install -y ripgrep
RUN echo "deb https://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/chrome.list && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /etc/apt/keyrings/google.gpg
RUN apt update
RUN apt install -y google-chrome-stable
RUN apt clean
